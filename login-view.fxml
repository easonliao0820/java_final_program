<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="25.0" style="-fx-background-color: #f8dda4; -fx-padding: 30;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">
   <children>
      <!-- Title Section -->
      <VBox alignment="CENTER" spacing="8.0">
         <children>
            <Label text="活動報名管理系統" textFill="#813405">
               <font>
                  <Font name="Microsoft JhengHei Bold" size="24.0" />
               </font>
            </Label>
            <Label text="請輸入帳號密碼以開始使用" textFill="#d45113">
               <font>
                  <Font name="Microsoft JhengHei" size="12.0" />
               </font>
            </Label>
         </children>
      </VBox>

      <!-- Input Credentials Form -->
      <GridPane hgap="10.0" vgap="15.0">
        <columnConstraints>
          <ColumnConstraints hgrow="NEVER" minWidth="80.0" prefWidth="80.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="240.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="35.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="35.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="帳　號：" textFill="#813405" GridPane.columnIndex="0" GridPane.rowIndex="0">
               <font>
                  <Font name="Microsoft JhengHei" size="14.0" />
               </font>
            </Label>
            <TextField fx:id="usernameField" promptText="請輸入帳號" style="-fx-pref-height: 30; -fx-background-color: #ddf9c1; -fx-border-color: #f9a03f; -fx-border-radius: 4; -fx-background-radius: 4;" GridPane.columnIndex="1" GridPane.rowIndex="0">
               <font>
                  <Font name="Microsoft JhengHei" size="13.0" />
               </font>
            </TextField>
            <Label text="密　碼：" textFill="#813405" GridPane.columnIndex="0" GridPane.rowIndex="1">
               <font>
                  <Font name="Microsoft JhengHei" size="14.0" />
               </font>
            </Label>
            <PasswordField fx:id="passwordField" promptText="請輸入密碼" style="-fx-pref-height: 30; -fx-background-color: #ddf9c1; -fx-border-color: #f9a03f; -fx-border-radius: 4; -fx-background-radius: 4;" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <font>
                  <Font name="Microsoft JhengHei" size="13.0" />
               </font>
            </PasswordField>
         </children>
      </GridPane>

      <!-- Role Selection Radios -->
      <HBox alignment="CENTER" spacing="40.0">
         <children>
            <RadioButton fx:id="studentRadio" mnemonicParsing="false" selected="true" text="我是學生" textFill="#813405">
               <font>
                  <Font name="Microsoft JhengHei" size="13.0" />
               </font>
               <toggleGroup>
                  <ToggleGroup fx:id="roleGroup" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="organizerRadio" mnemonicParsing="false" text="我是主辦者" textFill="#813405" toggleGroup="$roleGroup">
               <font>
                  <Font name="Microsoft JhengHei" size="13.0" />
               </font>
            </RadioButton>
         </children>
      </HBox>

      <!-- Actions Button Bar -->
      <HBox alignment="CENTER" spacing="20.0">
         <children>
            <Button fx:id="registerButton" mnemonicParsing="false" onAction="#handleRegisterDialog" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #f9a03f; -fx-text-fill: #813405; -fx-cursor: hand; -fx-background-radius: 4;" text="註冊新帳號">
               <font>
                  <Font name="Microsoft JhengHei" size="14.0" />
               </font>
            </Button>
            <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #d45113; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;" text="登　入">
               <font>
                  <Font name="Microsoft JhengHei" size="14.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
